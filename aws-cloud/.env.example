# Use a named profile from ~/.aws/config and ~/.aws/credentials. Never put keys here.
AWS_PROFILE=default
AWS_REGION=us-east-1

# Set to a globally unique, lowercase S3 bucket name before deploying.
S3_BUCKET_NAME=replace-with-globally-unique-name

# Optional source configuration. Mock weather keeps the first run independent of an API key.
USE_MOCK_WEATHER=true
WEATHER_LOCATIONS=New York,Detroit,Austin,Fremont,Toronto
WEATHERSTACK_API_KEY=
EV_DATA_PATH=../data/ev/fleet_operations_sample.json
LOG_LEVEL=INFO
